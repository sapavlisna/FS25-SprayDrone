<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Generováno z blender/templates/sprayDroneTrailerMiddle.xml.in skriptem blender/export_middle_mod.py. Needitovat ručně. -->
<vehicle type="FS25_SprayDroneTrailer.sprayDroneTrailer">
    <annotation>Spray drone service trailer (car version). Vzor: ABI Water Trailer 550, podvozek Stema Trius, nastupování jako Anderson hybridX.</annotation>

    <storeData>
        <name>$l10n_sdt_trailer_middle</name>
        <functions>
            <function>$l10n_function_tank</function>
        </functions>
        <image>vehicles/sprayDroneTrailerMiddle/store_sprayDroneTrailerMiddle.dds</image>
        <price>6100</price>
        <lifetime>600</lifetime>
        <rotation>0</rotation>
        <brand>BZUK</brand>
        <category>sprayDroneTrailers</category>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_sprayerTank</typeDesc>
        <filename>vehicles/sprayDroneTrailerMiddle/sprayDroneTrailerMiddle.i3d</filename>
        <size width="{{SIZE_WIDTH}}" length="{{SIZE_LENGTH}}" height="{{SIZE_HEIGHT}}" lengthOffset="{{SIZE_LENGTH_OFFSET}}"/>
        <components maxMass="6200">
            <component centerOfMass="0 0.95 0.10" solverIterationCount="10" mass="780"/>
        </components>
        <schemaOverlay attacherJointPosition="0 0" name="IMPLEMENT"/>
        <mapHotspot type="TOOL_TRAILED"/>
    </base>

    <!-- konfigurace Design (polepy BZUK / ROSA / kapka / STRATUS AGRI): export_middle_mod.design_configurations_xml z uzlů brand_<KEY>_* -->
{{DESIGN_CONFIGURATIONS}}

    <wheels>
        <wheelConfigurations>
            <wheelConfiguration name="$l10n_configuration_valueDefault" price="0" brand="LIZARD" saveId="DEFAULT" isDefault="true">
                <wheels>
{{WHEELS}}
                </wheels>
            </wheelConfiguration>
{{LEGACY_WHEELS}}
        </wheelConfigurations>
    </wheels>

    <attachable>
        <inputAttacherJoints>
            <inputAttacherJoint node="attacherJoint" jointType="trailerCar" attacherHeight="{{ATTACHER_HEIGHT}}"/>
            <inputAttacherJoint node="attacherJoint" jointType="trailerLow" attacherHeight="{{ATTACHER_HEIGHT}}"/>
            <inputAttacherJoint node="attacherJoint" jointType="trailer" attacherHeight="0.90"/>
        </inputAttacherJoints>
        <brakeForce force="0.1" maxForce="0.6" maxForceMass="6200"/>
        <support animationName="moveSupport"/>
        <sounds>
            <active file="$data/sounds/tools/sowing/generalRattle_02.wav" innerRadius="10" outerRadius="50" volumeScale="8.6" isLocalSound="true" pitchScale="1.2">
                <volume indoor="0.7" outdoor="0.9">
                    <modifier type="WHEEL_SUSPENSION" value="-0.08" modifiedValue="0.2"/>
                    <modifier type="WHEEL_SUSPENSION" value="-0.06" modifiedValue="0.2"/>
                    <modifier type="WHEEL_SUSPENSION" value="-0.04" modifiedValue="0.2"/>
                    <modifier type="WHEEL_SUSPENSION" value="-0.03" modifiedValue="0.2"/>
                    <modifier type="WHEEL_SUSPENSION" value="-0.02" modifiedValue="0.2"/>
                    <modifier type="WHEEL_SUSPENSION" value="-0.01" modifiedValue="0.1"/>
                    <modifier type="WHEEL_SUSPENSION" value="-0.00" modifiedValue="0.0"/>
                    <modifier type="WHEEL_SUSPENSION" value="0.01" modifiedValue="0.1"/>
                    <modifier type="WHEEL_SUSPENSION" value="0.02" modifiedValue="0.2"/>
                    <modifier type="WHEEL_SUSPENSION" value="0.03" modifiedValue="0.2"/>
                    <modifier type="WHEEL_SUSPENSION" value="0.04" modifiedValue="0.2"/>
                    <modifier type="WHEEL_SUSPENSION" value="0.06" modifiedValue="0.2"/>
                    <modifier type="WHEEL_SUSPENSION" value="0.08" modifiedValue="0.2"/>

                    <modifier type="SPEED" value="0.0" modifiedValue="0.0"/>
                    <modifier type="SPEED" value="2.0" modifiedValue="1.0"/>
                    <modifier type="SPEED" value="40.0" modifiedValue="1.0"/>
                </volume>
                <lowpassCutoffFrequency indoor="250" outdoor="20000"/>
                <lowpassGain indoor="0.5" outdoor="1"/>
            </active>
        </sounds>
    </attachable>

    <!-- stanoviště pilota dronu: nastoupit jde vždy, plánovač a start letu jen z rozloženého vleku (SprayDronePlannerScreen.lua, SprayDroneStation.lua) -->
    <enterable isTabbable="false">
        <enterReferenceNode node="sprayDroneTrailerMiddle_main_component1" interactionRadius="4"/>
        <exitPoint node="exitPoint"/>
        <cameras>
            <camera node="outdoorCamera" rotatable="true" rotateNode="outdoorCameraTarget" limit="true" useWorldXZRotation="true"
                    rotMinX="-1.4" rotMaxX="1.2" transMin="3" transMax="40" translation="0 0 9" rotation="-25 180 0"/>
        </cameras>
    </enterable>

    <licensePlates>
        <licensePlate node="licensePlateBack" position="BACK" preferedType="SQUARISH" placementArea="0.06 0.26 0.09 0.15"/>
    </licensePlates>

    <lights>
        <states>
            <state lightTypes="0"/>
        </states>
        <sharedLight linkNode="rearLight52_left" filename="$data/shared/assets/lights/lizard/rearLight52_left.xml"/>
        <sharedLight linkNode="rearLight52_right" filename="$data/shared/assets/lights/lizard/rearLight52_right.xml"/>
        <sharedLight linkNode="sideMarker05_left" filename="$data/shared/assets/lights/lizard/sideMarker05_left.xml"/>
        <sharedLight linkNode="sideMarker05_right" filename="$data/shared/assets/lights/lizard/sideMarker05_right.xml"/>
        <sharedLight linkNode="plateNumberLight03" filename="$data/shared/assets/lights/lizard/plateNumberLight03.xml"/>
    </lights>

    <animations>
        <!-- opěrné kolečko: čas 0 = zapřaženo (zvednuté), čas 1 = odpojeno (na zemi, model v i3d) -->
        <animation name="moveSupport">
            <part node="jockeyWheel" startTime="0" endTime="1" startTrans="{{JOCKEY_UP}}" endTrans="{{JOCKEY_DOWN}}"/>
            <!-- zvuky (vanilla šablony, vzor abi/waterTrailer550): čas 0 = zapřaženo, 1 = kolečko na zemi -->
            <sound template="slideOpen" startTime="0.02" direction="1" volumeScale="1.5" pitchScale="1.4" linkNode="jockeyWheel"/>
            <sound template="slideOpen" startTime="0.98" direction="-1" volumeScale="1.5" pitchScale="1.4" linkNode="jockeyWheel"/>
            <sound template="clackVar1" startTime="0.95" direction="1" volumeScale="1.1" pitchScale="1.1" linkNode="jockeyWheel"/>
            <sound template="clackVar1" startTime="0.05" direction="-1" volumeScale="1.1" pitchScale="1.1" linkNode="jockeyWheel"/>
        </animation>
        <!-- konvence FS25 (Foldable.lua): čas 0 = rozloženo (model v i3d), čas 1 = složeno;
             startMoveDirection="1" => vozidlo začíná v čase 1. Skládání: 0–2 s se složí dron na plošině (skript podle
             času skládání, sprayDrone#trailerFoldEnd); 2–2,4 s se zavřou úchyty lyžin dronu (sprayDrone#securedFoldTime = 2,4 / 3).
             Výsuvný žebřík (vpravo vpředu mezi sloupkem a plachtou, bez madel): rozložený je vysunutý a vyklopený na hácích, pata
             na zemi; při skládání spodní díl zajede nahoru (ladderSlide 2–2,4 s) a žebřík se na hácích naklopí do svislice
             (ladderHinge 2,3–2,6 s). Plachty (boky a předek) se
             zavírají 2,6–3 s, až je všechno uvnitř zasunuté; s nimi se z horní desky sklopí jejich kolize (colTarpHinge{L,R,F}). Řádky žebříku a plachet počítá build_trailer_middle.py
             z geometrie (vlastnost sdt_fold_parts) a export je vyplní do TARP_PARTS. ladderGrab je prázdný uzel. -->
        <animation name="foldLadder">
            <!-- truhla nabíječky na horní palubě: rozložený vlek = víko otevřené; kabel k elektrocentrále vede napevno po sloupku -->
            <part node="chargerLid" startTime="{{LID_START}}" endTime="{{LID_END}}" startRot="{{LID_OPEN}}" endRot="0 0 0"/>
            <!-- teleskopy antény a GPS se při skládání vleku zasunou (blender/build_trailer_middle.py: TELE_SECTIONS) -->
            <part node="antennaBoostedTele1" startTime="0.2" endTime="1.4" startTrans="0 0.750 0" endTrans="0 0.230 0"/>
            <part node="antennaBoostedTele2" startTime="0.2" endTime="1.4" startTrans="0 0.600 0" endTrans="0 0.130 0"/>
            <part node="antennaLargeTele1" startTime="0.2" endTime="1.4" startTrans="0 0.800 0" endTrans="0 0.230 0"/>
            <part node="antennaLargeTele2" startTime="0.2" endTime="1.4" startTrans="0 0.650 0" endTrans="0 0.180 0"/>
            <part node="gpsRtkBoxTele1" startTime="0.2" endTime="1.4" startTrans="0 0.500 0" endTrans="0 0.130 0"/>
            <part node="gpsRtkBoxTele2" startTime="0.2" endTime="1.4" startTrans="0 0.450 0" endTrans="0 0.130 0"/>
{{CLAMP_PARTS}}
{{TARP_PARTS}}
            <!-- zvuky (vanilla šablony): direction -1 = rozkládání, 1 = skládání -->
            <sound template="latchSmall" startTime="2.1" volumeScale="0.6" pitchScale="1.2" linkNode="chargerLid"/>
            <sound template="latchSmall" startTime="2.3" volumeScale="0.6" pitchScale="1" linkNode="chargerLid"/>
            <sound template="coverMetalOpen" startTime="2.95" direction="-1" volumeScale="1" pitchScale="1" linkNode="chargerLid"/>
            <sound template="metalClose" startTime="2.85" direction="1" volumeScale="0.8" pitchScale="1.1" linkNode="chargerLid"/>
        </animation>
    </animations>

    <foldable>
        <foldingConfigurations>
            <foldingConfiguration>
                <foldingParts startMoveDirection="1" requiresPower="false" attachingMinLimit="0.98" detachingMinLimit="0.98" objectText="$l10n_sdt_foldObject" unfoldWarning="$l10n_sdt_warning_foldFirst">
                    <foldingPart animationName="foldLadder" speedScale="1"/>
                </foldingParts>
            </foldingConfiguration>
        </foldingConfigurations>
    </foldable>

    <fillUnit>
        <fillUnitConfigurations>
            <!-- velikost nádrže vleku (kapacita a viditelná skupina tankMainNNN; objectChange každé konfigurace ukazuje svou skupinu
                 a v ostatních konfiguracích se použije visibilityInactive="false", takže je vždy vidět právě jedna). Pořadí fill units
                 se nesmí měnit: 1 hlavní nádrž (voda nebo hotový přípravek), 2 nafta pro elektrocentrálu (nabíjí baterie dronu; plní se
                 na čerpací stanici nebo z nádrže na naftu), 3 koncentrát pro mixér (scripts/SprayDroneStation.lua, sprayDrone#mixer) -->
            <fillUnitConfiguration name="800 l" price="0" saveId="TANK800">
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="water liquidFertilizer herbicide" capacity="800">
                        <exactFillRootNode node="exactFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="diesel" capacity="30">
                        <exactFillRootNode node="dieselFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="SDT_CONCENTRATE_FERTILIZER SDT_CONCENTRATE_HERBICIDE" capacity="40">
                        <exactFillRootNode node="concentrateFillRootNode"/>
                    </fillUnit>
                </fillUnits>
                <objectChange node="tankMain800" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="colTank800" compoundChildActive="true" compoundChildInactive="false"/>
            </fillUnitConfiguration>
            <fillUnitConfiguration name="1000 l" price="400" saveId="TANK1000" isDefault="true">
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="water liquidFertilizer herbicide" capacity="1000">
                        <exactFillRootNode node="exactFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="diesel" capacity="30">
                        <exactFillRootNode node="dieselFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="SDT_CONCENTRATE_FERTILIZER SDT_CONCENTRATE_HERBICIDE" capacity="50">
                        <exactFillRootNode node="concentrateFillRootNode"/>
                    </fillUnit>
                </fillUnits>
                <objectChange node="tankMain1000" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="colTank1000" compoundChildActive="true" compoundChildInactive="false"/>
            </fillUnitConfiguration>
            <fillUnitConfiguration name="1500 l" price="1300" saveId="TANK1500">
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="water liquidFertilizer herbicide" capacity="1500">
                        <exactFillRootNode node="exactFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="diesel" capacity="30">
                        <exactFillRootNode node="dieselFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="SDT_CONCENTRATE_FERTILIZER SDT_CONCENTRATE_HERBICIDE" capacity="75">
                        <exactFillRootNode node="concentrateFillRootNode"/>
                    </fillUnit>
                </fillUnits>
                <objectChange node="tankMain1500" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="colTank1500" compoundChildActive="true" compoundChildInactive="false"/>
            </fillUnitConfiguration>
            <fillUnitConfiguration name="3000 l" price="3500" saveId="TANK3000">
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="water liquidFertilizer herbicide" capacity="3000">
                        <exactFillRootNode node="exactFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="diesel" capacity="30">
                        <exactFillRootNode node="dieselFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="SDT_CONCENTRATE_FERTILIZER SDT_CONCENTRATE_HERBICIDE" capacity="150">
                        <exactFillRootNode node="concentrateFillRootNode"/>
                    </fillUnit>
                </fillUnits>
                <objectChange node="tankMain3000" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="colTank3000" compoundChildActive="true" compoundChildInactive="false"/>
            </fillUnitConfiguration>
            <fillUnitConfiguration name="5000 l" price="6000" saveId="TANK5000">
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="water liquidFertilizer herbicide" capacity="5000">
                        <exactFillRootNode node="exactFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="diesel" capacity="30">
                        <exactFillRootNode node="dieselFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="SDT_CONCENTRATE_FERTILIZER SDT_CONCENTRATE_HERBICIDE" capacity="250">
                        <exactFillRootNode node="concentrateFillRootNode"/>
                    </fillUnit>
                </fillUnits>
                <objectChange node="tankMain5000" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="colTank5000" compoundChildActive="true" compoundChildInactive="false"/>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <!-- z nádrže vleku se dočerpává dron (a případně pozemní postřikovač zajetý vedle vleku) -->
    <fillTriggerVehicle triggerNode="fillTrigger" fillUnitIndex="1" litersPerSecond="200"/>

    <!-- voda z vodní plochy (vanilla WaterTrailer, vzor abi/waterTrailer550): R u hladiny napouští hlavní nádrž (fillUnit 1), jen když je
         kořen vleku (fillNode) nejvýš 0,2 m nad hladinou, tedy vlek stojí u vody; do nádrže s přípravkem se voda nenapustí -->
    <waterTrailer fillUnitIndex="1" fillLitersPerSecond="300">
        <sounds>
            <refill template="defaultRefuelSound" linkNode="0>"/>
        </sounds>
    </waterTrailer>

    <!-- postřikový dron (scripts/SprayDroneStation.lua, docs/DRON.md); schéma vehicle.xsd tuhle sekci nezná.
         Atributy <sprayDrone> jsou společné, blok <drone> varianty (S / M / L, vybírá konfigurace sprayDrone#drone) je
         přepisuje; uzly varianty mají prefix (<prefix>Root, Tilt, FillPort, BatterySlot, Clamp_i), bez dronu (drone="") je
         vlek jen nabíječka a nádrž. droneMass = dron bez baterie, batteryMass se přičte; batteryKwh jen pro zobrazení.
         foldPart: natočení kloubů složeno/rozloženo (čas 0..1 rozložení), rotor: vrtule, která se za letu točí;
         batteryMinutes: výdrž ve vodorovném letu s plnou nádrží, odběr roste s kvadrátem hmotnosti a s fází letu,
         baterie se na vleku mění pod batterySwapBelow kapacity;
         sounds.rotor: smyčka rotorů, výšku a hlasitost podle otáček řídí skript, rotorPitch = výška varianty;
         litersPerSecond: čerpadlo, kterým se dron na plošině plní z nádrže vleku;
         power: elektrocentrála (nafta z fillUnit dieselFillUnitIndex) nabíjí baterie ve slotech vleku (i složeného);
         chargeMinutes = nabití jedné baterie z 30 % na 95 %, dieselPerHour = spotřeba při nabíjení jedné baterie (varianta
         je přepisuje), readyLevel = od kolika jde baterie do dronu; počet baterií (0..5, vlek má 5 slotů, typ podle dronu) je
         konfigurace v obchodě sprayDroneBatteryConfigurations, power#batteries platí bez ní; transfer: vypouštění dronu do
         vleku a přečerpání vleku do IBC (l/s, dosah IBC v m); navLight: LED ramen (svit shaderem lightIds0 a bodové světlo);
         effects: mlha z trysek, vlastní částicový efekt effects/sprayMist.i3d (ParticleEffect, jeden emitor na trysku; emitory
         0|0 = S, 0|1 = M, 0|2 = L se liší rozevřením kužele, které pak u země dosáhne záběru varianty); skript emitory postaví
         pod trysky (uzly nebo x/z nozzle, jinak pod motory ramen) do výšky nozzleY pod kloubem náklonu -->
    <sprayDrone fillUnitIndex="1" maxRange="750"
                batteryHoverFactor="1.15" batteryClimbFactor="1.4" batteryDescentFactor="0.8" batterySwapBelow="0.3" trailerFoldEnd="0.667" batteryStowFrom="0.06" batteryStowUntil="0.55"
                cruiseSpeed="10" sprayingSpeed="7" climbSpeed="3" ascentSpeed="5" acceleration="2.5" yawSpeed="90"
                sprayHeight="3" transitHeight="12" obstacleClearance="5" maxTransitHeight="60" corridorHeight="8" usageScale="0.2"
                sideClearance="4" turnAcceleration="2.5"
                litersPerSecond="1" securedFoldTime="0.8">
        <sprayDroneConfigurations>
            <sprayDroneConfiguration name="$l10n_sdt_configuration_droneS" drone="S" price="7000" saveId="S" workingWidth="6">
                <objectChange node="Drone_S_Root" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="Drone_S_Clamp_1" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="Drone_S_Clamp_2" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="Drone_S_Clamp_3" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="Drone_S_Clamp_4" visibilityActive="true" visibilityInactive="false"/>
            </sprayDroneConfiguration>
            <sprayDroneConfiguration name="$l10n_sdt_configuration_droneM" drone="M" price="12000" saveId="M" workingWidth="9" isDefault="true">
                <objectChange node="Drone_A_Root" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="Drone_A_Clamp_1" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="Drone_A_Clamp_2" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="Drone_A_Clamp_3" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="Drone_A_Clamp_4" visibilityActive="true" visibilityInactive="false"/>
            </sprayDroneConfiguration>
            <sprayDroneConfiguration name="$l10n_sdt_configuration_droneL" drone="L" price="22000" saveId="L" workingWidth="11">
                <objectChange node="Drone_L_Root" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="Drone_L_Clamp_1" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="Drone_L_Clamp_2" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="Drone_L_Clamp_3" visibilityActive="true" visibilityInactive="false"/>
                <objectChange node="Drone_L_Clamp_4" visibilityActive="true" visibilityInactive="false"/>
            </sprayDroneConfiguration>
        </sprayDroneConfigurations>
        <sprayDroneBatteryConfigurations>
            <sprayDroneBatteryConfiguration name="0" count="0" price="0" saveId="0"/>
            <sprayDroneBatteryConfiguration name="1" count="1" price="1500" saveId="1"/>
            <sprayDroneBatteryConfiguration name="2" count="2" price="3000" saveId="2"/>
            <sprayDroneBatteryConfiguration name="3" count="3" price="4500" saveId="3" isDefault="true"/>
            <sprayDroneBatteryConfiguration name="4" count="4" price="6000" saveId="4"/>
            <sprayDroneBatteryConfiguration name="5" count="5" price="7500" saveId="5"/>
            <sprayDroneBatteryConfiguration name="6" count="6" price="9000" saveId="6"/>
        </sprayDroneBatteryConfigurations>
        <!-- anténa vysílačky a přesná GPS (jen Middle a Max): rangeBonus násobí dosah dronů (sprayDrone#maxRange), usageFactor spotřebu l/ha -->
        <sprayDroneAntennaConfigurations>
            <sprayDroneAntennaConfiguration name="$l10n_sdt_antenna_none" rangeBonus="1" price="0" saveId="NONE" isDefault="true">
                <objectChange node="antennaBase" visibilityActive="true" visibilityInactive="false"/>
            </sprayDroneAntennaConfiguration>
            <sprayDroneAntennaConfiguration name="$l10n_sdt_antenna_boosted" rangeBonus="1.35" price="1200" saveId="BOOSTED">
                <objectChange node="antennaBoosted" visibilityActive="true" visibilityInactive="false"/>
            </sprayDroneAntennaConfiguration>
            <sprayDroneAntennaConfiguration name="$l10n_sdt_antenna_large" rangeBonus="1.7" price="3000" saveId="LARGE">
                <objectChange node="antennaLarge" visibilityActive="true" visibilityInactive="false"/>
            </sprayDroneAntennaConfiguration>
        </sprayDroneAntennaConfigurations>
        <sprayDroneGpsConfigurations>
            <sprayDroneGpsConfiguration name="$l10n_sdt_gps_standard" usageFactor="1" price="0" saveId="STANDARD" isDefault="true"/>
            <sprayDroneGpsConfiguration name="$l10n_sdt_gps_rtk" usageFactor="0.85" price="2500" saveId="RTK">
                <objectChange node="gpsRtkBox" visibilityActive="true" visibilityInactive="false"/>
            </sprayDroneGpsConfiguration>
        </sprayDroneGpsConfigurations>
        <!-- vzhled vrtulí: kind default = podle modelu (T50 bílé bez proužků, T25 a T100 karbon s oranžovými), paint = barva listů,
             carbon = karbon; tips: proužky na koncích listů (none = bez nich) -->
        <sprayDronePropellerConfigurations>
            <sprayDronePropellerConfiguration name="$l10n_sdt_prop_default" kind="default" price="0" saveId="DEFAULT" isDefault="true"/>
            <sprayDronePropellerConfiguration name="$l10n_sdt_prop_black" kind="paint" color="0.03 0.03 0.035" price="0" saveId="BLACK"/>
            <sprayDronePropellerConfiguration name="$l10n_sdt_prop_white" kind="paint" color="0.85 0.86 0.87" price="0" saveId="WHITE"/>
            <sprayDronePropellerConfiguration name="$l10n_sdt_prop_carbon" kind="carbon" price="300" saveId="CARBON"/>
            <sprayDronePropellerConfiguration name="$l10n_sdt_prop_green" kind="paint" color="0.30 1.0 0.02" glow="1.5" price="150" saveId="GREEN"/>
            <sprayDronePropellerConfiguration name="$l10n_sdt_prop_yellow" kind="paint" color="0.85 1.0 0.02" glow="1.5" price="150" saveId="YELLOW"/>
            <sprayDronePropellerConfiguration name="$l10n_sdt_prop_orange" kind="paint" color="1.0 0.30 0.0" glow="1.5" price="150" saveId="ORANGE"/>
        </sprayDronePropellerConfigurations>
        <sprayDroneTipsConfigurations>
            <sprayDroneTipsConfiguration name="$l10n_sdt_prop_default" kind="default" price="0" saveId="DEFAULT" isDefault="true"/>
            <sprayDroneTipsConfiguration name="$l10n_sdt_tips_none" kind="none" price="0" saveId="NONE"/>
            <sprayDroneTipsConfiguration name="$l10n_sdt_prop_orange" kind="paint" color="1.0 0.30 0.0" glow="1.5" price="50" saveId="ORANGE"/>
            <sprayDroneTipsConfiguration name="$l10n_sdt_prop_yellow" kind="paint" color="0.85 1.0 0.02" glow="1.5" price="50" saveId="YELLOW"/>
            <sprayDroneTipsConfiguration name="$l10n_sdt_tips_red" kind="paint" color="0.85 0.02 0.02" price="50" saveId="RED"/>
            <sprayDroneTipsConfiguration name="$l10n_sdt_prop_green" kind="paint" color="0.30 1.0 0.02" glow="1.5" price="50" saveId="GREEN"/>
            <sprayDroneTipsConfiguration name="$l10n_sdt_tips_blue" kind="paint" color="0.05 0.25 0.85" price="50" saveId="BLUE"/>
            <sprayDroneTipsConfiguration name="$l10n_sdt_prop_white" kind="paint" color="0.90 0.90 0.90" price="50" saveId="WHITE"/>
        </sprayDroneTipsConfigurations>
        <power dieselFillUnitIndex="2" slots="6" batteries="3" chargeMinutes="10" dieselPerHour="2.2" readyLevel="0.95" swapTime="5">
            <exhaust node="generatorExhaust" filename="$data/effects/exhaust/exhaust.i3d" color="0.12 0.12 0.12 0.35" scale="0.35"/>
        </power>
        <!-- mixér: při plnění dronu z vody v hlavní nádrži a koncentrátu ve fill unit 3 vzniká přípravek; concentrate = podíl
             koncentrátu v hotovém přípravku (litr koncentrátu na litr přípravku), zbytek je voda -->
        <mixer concentrateFillUnitIndex="3">
            <ratio fillType="SDT_CONCENTRATE_FERTILIZER" product="liquidFertilizer" concentrate="0.05"/>
            <ratio fillType="SDT_CONCENTRATE_HERBICIDE" product="herbicide" concentrate="0.05"/>
        </mixer>
        <!-- skříň s kanystry: rolovací vrata (doorNode, žádný lidNode/openAngle - viz SprayDroneToolbox.applyLid),
             kanystry toolboxCanister1..48 (čtyři patra po dvou řadách po šesti, Pavel 2026-10-09: zadní stěna u
             nádrže, vrata ven z vleku v rovině s jeho zadní hranou, skříň sahá vzhůru ke stropu). Žádný slot není
             vyhrazený, kterýkoli pojme koncentrát i naftu; otvor pro vsátí pokrývá celý otvor vrat (aktivační uzel je uprostřed výšky skříně). neckNode = hrdlo indukční nádrže.
             doorTravel (m) = o kolik panel vrat při otevření vyjede nahoru (po ose Y rodiče) do pouzdra roletové schránky nad otvorem
             (Toolbox_Housing* v i3d: krycí plech s válcem před dutinou mezi horním patrem a stropem; pivot je nahoře uprostřed
             otvoru). Panel (plná výška otvoru 1,39 m) se tam vejde jen svinutý (scale.y -> DOOR_OPEN_SCALE) -->
        <toolbox slots="48" slotLiters="20" activateNode="toolboxActivateNode" doorNode="Toolbox_Door" doorTravel="{{DOOR_TRAVEL}}" canisterNodePrefix="toolboxCanister" neckNode="concentrateNeckNode" intakeBelow="0.7" intakeAbove="0.7"/>
        <transfer drainRate="1" palletRate="20" palletDistance="6"/>
        <!-- rozložit jde jen vlek, který stojí dost rovně: největší náklon paluby (°) podélně i příčně (scripts/SprayDroneLevel.lua);
             náklon se u složeného vleku ukazuje zeleně / červeně -->
        <tilt max="5"/>
        <navLights intensity="4" lightScale="0.3" blinkPeriod="1" blinkOn="0.5"/>
        <sounds>
            <!-- naftový agregát: motor (vanilla čerpadlo rýžových polí) + hluboké hučení alternátoru; rozjezd a doběh řídí SprayDroneSound.lua
                 linkNode generatorExhaust (výfuk u motoru) -->
            <generator template="riceFieldPump" linkNode="generatorExhaust" innerRadius="3" outerRadius="45" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.35" outdoor="0.5"/>
                <pitch indoor="1" outdoor="1"/>
                <lowpassGain indoor="0.4" outdoor="1"/>
            </generator>
            <generatorHum template="generator05" volumeScale="1" linkNode="generatorExhaust" innerRadius="2" outerRadius="30" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.5" outdoor="0.7"/>
                <pitch indoor="1" outdoor="1"/>
                <lowpassGain indoor="0.4" outdoor="1"/>
            </generatorHum>
            <!-- mixér (hraje při spec.isMixing): motor s míchadlem (vanilla míchací vůz, výše laděný) + šplouchání kapaliny;
                 linkNode mixerSoundNode (empty u mixéru) -->
            <mixer template="mixerLoop" linkNode="mixerSoundNode" innerRadius="2" outerRadius="30" fadeIn="0.2" fadeOut="0.3">
                <volume indoor="0.25" outdoor="1.0"/>
                <pitch indoor="1.35" outdoor="1.35"/>
                <lowpassGain indoor="0.4" outdoor="1"/>
            </mixer>
            <mixerLiquid template="riceFieldWater" linkNode="mixerSoundNode" innerRadius="2" outerRadius="20" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.1" outdoor="0.6"/>
                <pitch indoor="1.1" outdoor="1.1"/>
                <lowpassGain indoor="0.4" outdoor="1"/>
            </mixerLiquid>
            <!-- čerpadlo plnění dronu (isPumping), přečerpávání (transfer), plnicí hadice a výměna baterie: vanilla vzorky -->
            <pump template="pressureWasherRun01" linkNode="fillHoseCoil" innerRadius="3" outerRadius="30" fadeIn="0.2" fadeOut="0.3" volumeScale="0.8"/>
            <transfer template="defaultRefuelSound" linkNode="fillHoseCoil" innerRadius="3" outerRadius="30" fadeIn="0.2" fadeOut="0.3" volumeScale="0.8"/>
            <hoseAttach template="hydraulicHosesAttach" linkNode="fillHoseCoil" innerRadius="3" outerRadius="30" volumeScale="0.7"/>
            <hoseDetach template="hydraulicHosesDetach" linkNode="fillHoseCoil" innerRadius="3" outerRadius="30" volumeScale="0.7"/>
            <batteryInsert template="clickLong" linkNode="batteryCharger" innerRadius="2" outerRadius="20" volumeScale="0.9"/>
            <!-- nalévání z kanystru (R u hrdla i nakloněný kanystr): smyčka, dokud z kanystru teče; vypouštění koncentrátu na zem (Ctrl+I);
                 skládání a rozkládání vleku (smyčka po dobu animace skládání, panely i žebřík); otevření / zavření bedny nebo vrat skříně.
                 Řídí SprayDroneSound.lua, vzorky jsou vanilla šablony -->
            <pour template="defaultRefuelSound" linkNode="concentrateNeckNode" innerRadius="2" outerRadius="25" fadeIn="0.1" fadeOut="0.2" volumeScale="0.7"/>
            <groundDrain template="riceFieldWater" linkNode="concentrateNeckNode" innerRadius="3" outerRadius="30" fadeIn="0.2" fadeOut="0.3" volumeScale="1.2">
                <volume indoor="0.2" outdoor="1.0"/>
                <pitch indoor="0.9" outdoor="0.9"/>
                <lowpassGain indoor="0.4" outdoor="1"/>
            </groundDrain>
            <door template="rollingGarageDoor" linkNode="toolboxActivateNode" innerRadius="3" outerRadius="30" fadeIn="0.1" fadeOut="0.2" volumeScale="0.8"/>
            <!-- ramena a listy dronu: jedno cvaknutí na každý stupeň rozložení (SprayDroneSound.UNFOLD_STAGES), loop skládání vleku je pryč -->
            <droneUnfoldStep template="hingeSmall" linkNode="0>" innerRadius="4" outerRadius="40" volumeScale="0.9"/>
            <droneFoldStep template="clackVar2" linkNode="0>" innerRadius="4" outerRadius="40" volumeScale="0.8"/>
            <boxOpen template="latchSmall" linkNode="toolboxActivateNode" innerRadius="2" outerRadius="25" volumeScale="0.8"/>
            <boxClose template="metalClose" linkNode="toolboxActivateNode" innerRadius="2" outerRadius="25" volumeScale="0.8"/>
        </sounds>

        <!-- malý „S“ podle DJI T25: 25,4 kg + DB800 6,6 kg (0,81 kWh), 20 l, záběr 6 m, 4 jednoduché vrtule 50″, 2 zadní trysky
             (rozteč 1368 mm); výdrž 9 min s plnou nádrží (výkon ~ m^1,5 / √plocha vrtulí, kalibrováno na T50) -->
        <drone name="S" prefix="Drone_S_" maxRange="300" litersPerSecond="1" tankCapacity="20" workWidth="6" droneMass="25.4" batteryMass="6.6" batteryKwh="0.81"
               batteryMinutes="9" chargeMinutes="10" dieselPerHour="1.14" droneRadius="1.35" rotorPitch="1.25" hoseVia="0.145 0.15 0.24">
            <sounds>
                <rotor file="sounds/droneRotorLoop.ogg" linkNode="Drone_S_Tilt" innerRadius="6" outerRadius="100" fadeOut="0.3">
                    <volume indoor="0.5" outdoor="1.0"/>
                    <pitch indoor="1" outdoor="1"/>
                    <lowpassGain indoor="0.6" outdoor="1"/>
                </rotor>
                <spray template="defaultSprayer" linkNode="Drone_S_Tilt" innerRadius="5" outerRadius="80" volumeScale="0.5" pitchScale="1.1"/>
            </sounds>
            <effects nozzleY="-0.08">
                <nozzle x="-0.684" z="-0.657"/>
                <nozzle x="0.684" z="-0.657"/>
                <effectNode effectClass="ParticleEffect" filename="effects/sprayMist.i3d" node="0|0" linkNode="Drone_S_Tilt" particleType="SMOKE" materialType="smokeParticle" worldSpace="true" ignoreDistanceLifeSpan="true" useCuttingWidth="false"/>
                <effectNode effectClass="ParticleEffect" filename="effects/sprayMist.i3d" node="0|0" linkNode="Drone_S_Tilt" particleType="SMOKE" materialType="smokeParticle" worldSpace="true" ignoreDistanceLifeSpan="true" useCuttingWidth="false"/>
            </effects>
{{DRONE_PARTS_S}}
        </drone>

        <!-- střední „M“ = DJI T50 (dnešní): 39,9 kg + DB1560 12,1 kg (1,567 kWh), 40 l, záběr 9 m, 4 trysky pod motory -->
        <drone name="M" prefix="Drone_A_" maxRange="450" litersPerSecond="1.5" tankCapacity="40" workWidth="9" droneMass="39.9" batteryMass="12.1" batteryKwh="1.567"
               batteryMinutes="8" chargeMinutes="10" dieselPerHour="2.2" droneRadius="1.6" rotorPitch="1" hoseVia="0.17 0.155 0.32">
            <sounds>
                <rotor file="sounds/droneRotorLoop.ogg" linkNode="Drone_A_Tilt" innerRadius="8" outerRadius="120" fadeOut="0.3">
                    <volume indoor="0.6" outdoor="1.2"/>
                    <pitch indoor="1" outdoor="1"/>
                    <lowpassGain indoor="0.6" outdoor="1"/>
                </rotor>
                <spray template="defaultSprayer" linkNode="Drone_A_Tilt" innerRadius="6" outerRadius="100" volumeScale="0.6" pitchScale="1.0"/>
            </sounds>
            <effects nozzleY="-0.11">
                <effectNode effectClass="ParticleEffect" filename="effects/sprayMist.i3d" node="0|1" linkNode="Drone_A_Tilt" particleType="SMOKE" materialType="smokeParticle" worldSpace="true" ignoreDistanceLifeSpan="true" useCuttingWidth="false"/>
                <effectNode effectClass="ParticleEffect" filename="effects/sprayMist.i3d" node="0|1" linkNode="Drone_A_Tilt" particleType="SMOKE" materialType="smokeParticle" worldSpace="true" ignoreDistanceLifeSpan="true" useCuttingWidth="false"/>
                <effectNode effectClass="ParticleEffect" filename="effects/sprayMist.i3d" node="0|1" linkNode="Drone_A_Tilt" particleType="SMOKE" materialType="smokeParticle" worldSpace="true" ignoreDistanceLifeSpan="true" useCuttingWidth="false"/>
                <effectNode effectClass="ParticleEffect" filename="effects/sprayMist.i3d" node="0|1" linkNode="Drone_A_Tilt" particleType="SMOKE" materialType="smokeParticle" worldSpace="true" ignoreDistanceLifeSpan="true" useCuttingWidth="false"/>
            </effects>
{{DRONE_PARTS_M}}
        </drone>

        <!-- velký „L“ podle DJI T100: 75 kg „weight for spraying“ včetně DB2160 14,7 kg (MTOW 175 = 75 + 100), tedy 60,3 kg bez
             baterie; DB2160 41 Ah × 52 V = 2,13 kWh, nabití 30 → 95 % za 8–9 min; nádrž ve hře 75 l (se 100 l by výdrž vyšla
             4,8 min, se 75 l 6,0 min), záběr 11 m, 2 trysky na rameni postřiku (rozteč 1834 mm) -->
        <drone name="L" prefix="Drone_L_" maxRange="600" litersPerSecond="2.5" tankCapacity="75" workWidth="11" droneMass="60.3" batteryMass="14.7" batteryKwh="2.13"
               batteryMinutes="6" chargeMinutes="8.5" dieselPerHour="3.52" droneRadius="1.65" rotorPitch="0.8" hoseVia="0.20 0.19 0.40">
            <sounds>
                <rotor file="sounds/droneRotorLoop.ogg" linkNode="Drone_L_Tilt" innerRadius="10" outerRadius="150" fadeOut="0.3">
                    <volume indoor="0.7" outdoor="1.4"/>
                    <pitch indoor="1" outdoor="1"/>
                    <lowpassGain indoor="0.6" outdoor="1"/>
                </rotor>
                <spray template="defaultSprayer" linkNode="Drone_L_Tilt" innerRadius="8" outerRadius="120" volumeScale="0.7" pitchScale="0.9"/>
            </sounds>
            <effects nozzleY="-0.24">
                <nozzle x="-0.917" z="-0.823"/>
                <nozzle x="0.917" z="-0.823"/>
                <effectNode effectClass="ParticleEffect" filename="effects/sprayMist.i3d" node="0|2" linkNode="Drone_L_Tilt" particleType="SMOKE" materialType="smokeParticle" worldSpace="true" ignoreDistanceLifeSpan="true" useCuttingWidth="false"/>
                <effectNode effectClass="ParticleEffect" filename="effects/sprayMist.i3d" node="0|2" linkNode="Drone_L_Tilt" particleType="SMOKE" materialType="smokeParticle" worldSpace="true" ignoreDistanceLifeSpan="true" useCuttingWidth="false"/>
            </effects>
{{DRONE_PARTS_L}}
        </drone>
    </sprayDrone>

    <foliageBending>
        <bendingNode minX="-1.4" maxX="1.4" minZ="{{BEND_MIN_Z}}" maxZ="{{BEND_MAX_Z}}" yOffset="0.3"/>
    </foliageBending>

    <ai>
        <agentAttachment jointNode="attacherJoint" rotCenterWheelIndices="1 2 3 4" width="{{SIZE_WIDTH}}" height="{{SIZE_HEIGHT}}" length="{{SIZE_LENGTH}}" lengthOffset="{{SIZE_LENGTH_OFFSET}}"/>
    </ai>

    <tipOccluder>
        <occlusionArea start="occlusionAreaStart" width="occlusionAreaWidth" height="occlusionAreaHeight"/>
    </tipOccluder>

    <wearable wearDuration="480" workMultiplier="5" fieldMultiplier="2"/>
    <washable dirtDuration="90" washDuration="1" workMultiplier="2" fieldMultiplier="2"/>

    <!-- barva ráfků v obchodě (materiál rim_outer_mat v wheels/sdtRim*.i3d) -->
    <rimColorConfigurations>
        <rimColorConfiguration materialTemplateName="RIM_DEFAULT" isDefault="true"/>
        <rimColorConfiguration materialTemplateName="RIM_CONFIGURATION_WHITE"/>
        <rimColorConfiguration materialTemplateName="RIM_CONFIGURATION_BLACK"/>
        <rimColorConfiguration materialTemplateName="ARMATRAC_ORANGE1" price="150"/>
        <rimColorConfiguration materialTemplateName="ARMATRAC_RED1" price="150"/>
        <rimColorConfiguration materialTemplateName="DOBLETT_BLUE1" price="150"/>
        <rimColorConfiguration materialTemplateName="DOBLETT_GREEN1" price="150"/>
        <rimColorConfiguration materialTemplateName="RISUTEC_YELLOW1" price="150"/>
        <rimColorConfiguration materialTemplateName="RIM_CONFIGURATION_CHROME" price="1000"/>
    </rimColorConfigurations>

    <!-- barva plachet a zadních vrat (materiál SDT_Tarp, i3d slot SDT_Tarp: plachty, role, roleta/pole vrat; lemy a popruhy zůstávají
         tmavé). materialTemplateUseColorOnly: mění se jen colorScale, plachta si nechá šablonu fabric1 (textura tkaniny); fabric1 má
         světlý detailDiffuse (~0,83), výchozí šedá je proto barva / 0,83 jako v export_middle_mod.MATERIAL_MAP. Lockupy designu jsou
         bez podkladu ve dvou sadách (sdt_parts.brand_tone_group): světlé barvy (oranžová, žlutá, šedá, bílá - jas šablony nad ~0,4)
         ukážou lockupOnLight s tmavým textem, ostatní lockupOnDark ({{TONE_*}} vyplní export); barvy, které hra přidá sama
         (useDefaultColors, vlastní barva), mají lockupOnDark. Nabídka jako bedna Mini. -->
    <baseColorConfigurations title="$l10n_sdt_cfg_tarpColor" useDefaultColors="true" price="0" defaultColorMaterialTemplateName="calibratedPaint">
        <baseColorConfiguration name="$l10n_sdt_cfg_tarpGrey" color="0.083 0.094 0.109" uiColor="0.29 0.31 0.33" isDefault="true">{{TONE_DARK}}</baseColorConfiguration>
        <baseColorConfiguration materialTemplateName="ARMATRAC_RED1">{{TONE_DARK}}</baseColorConfiguration>
        <baseColorConfiguration materialTemplateName="ARMATRAC_ORANGE1">{{TONE_LIGHT}}</baseColorConfiguration>
        <baseColorConfiguration materialTemplateName="RISUTEC_YELLOW1">{{TONE_LIGHT}}</baseColorConfiguration>
        <baseColorConfiguration materialTemplateName="DOBLETT_BLUE1">{{TONE_DARK}}</baseColorConfiguration>
        <baseColorConfiguration materialTemplateName="RISUTEC_GREY1">{{TONE_LIGHT}}</baseColorConfiguration>
        <baseColorConfiguration materialTemplateName="RIM_CONFIGURATION_WHITE">{{TONE_LIGHT}}</baseColorConfiguration>
        <baseColorConfiguration materialTemplateName="RIM_CONFIGURATION_BLACK">{{TONE_DARK}}</baseColorConfiguration>
        <material materialSlotName="SDT_Tarp" materialTemplateUseColorOnly="true"/>
    </baseColorConfigurations>

{{I3D_MAPPINGS}}
</vehicle>
