     "keys": [
       {"t": 0, "x": 14, "y": 1.3, "z": -666.5, "rel": "terrain", "tat": "pickup", "tx": 0, "ty": 1.9, "tz": 0, "fov": 34},
       {"t": 9, "x": 14, "y": 1.3, "z": -666.5, "rel": "terrain", "tat": "pickup", "tx": 0, "ty": 2.5, "tz": 0, "fov": 17}
     ]},
