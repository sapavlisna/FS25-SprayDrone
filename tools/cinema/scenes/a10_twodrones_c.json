    {"cmd": "waitDrone", "trailer": "max", "cond": "parked", "drone": 2, "timeout": 120, "optional": true},
    {"sleep": 1.0},
    {"cmd": "placeSet", "trailer": "middle", "tractor": "pickup", "x": -640, "z": 110, "yaw": 90, "unfolded": false},
