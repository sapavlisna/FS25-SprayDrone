<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Pravidla objektu ručně; i3d, obrázek a čísla v i3dMappings dává blender/build_limebag.py. Cestu k souboru čte SprayDroneToolbox.lua. -->
<vehicle type="pallet">
    <annotation>Pytel 50 l jemně mletého vápna z koncentrátové nádrže servisního vleku (Ctrl+I); herní objekt typu pallet.</annotation>

    <storeData>
        <name>$l10n_sdt_limeBag50_name</name>
        <functions>
            <function>$l10n_sdt_limeBag_function</function>
        </functions>
        <specs>
            <capacity>50</capacity>
            <fillTypes>SDT_FINE_LIME</fillTypes>
            <weight ignore="true"/>
        </specs>
        <image>objects/limeBag/store_limeBag50.dds</image>
        <price>150</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <rotation>0</rotation>
        <shopHeight>0.2</shopHeight>
        <brand>BZUK</brand>
        <!-- první kategorie (kořenová) je vanilla typu OBJECTS: seznam vlastněných v obchodě (FS25_GarageMenu) podle ní spotřební věci vynechá jako vanilla palety -->
        <category>pallets sprayDroneCanisters</category>
        <financeCategory>PURCHASE_FERTILIZER</financeCategory>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>objects/limeBag/limeBag50.i3d</filename>
        <size width="0.75" length="0.43" height="0.17"/>
        <canBeReset>false</canBeReset>
        <supportsPickUp>true</supportsPickUp>
        <components>
            <component centerOfMass="0 0.07 0" solverIterationCount="10" mass="1"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false"/>
        <input allowed="false"/>
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits removeVehicleIfEmpty="true">
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="SDT_FINE_LIME" capacity="50" startFillType="SDT_FINE_LIME" startFillLevel="50" ignoreFillLimit="true" updateMass="false">
                        <fillRootNode node="0&gt;"/>
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <fillTriggerVehicle triggerNode="fillTrigger" fillUnitIndex="1" litersPerSecond="50"/>

    <dynamicMount triggerNode="dynamicMountTrigger" triggerForceAcceleration="4" additionalMountDistance="0.09" jointTransY="0.02" jointLimitToRotY="true"/>

    <i3dMappings>
        <i3dMapping id="limeBag50_main_component1" node="0&gt;"/>
        <i3dMapping id="limeBag50_vis" node="0&gt;4"/>
        <i3dMapping id="floorCollision01" node="0&gt;1|0"/>
        <i3dMapping id="dynamicMountTrigger" node="0&gt;2"/>
        <i3dMapping id="fillTrigger" node="0&gt;3"/>
        <i3dMapping id="canisterCap" node="0&gt;0"/>
    </i3dMappings>
</vehicle>
