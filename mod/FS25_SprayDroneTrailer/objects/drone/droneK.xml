<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Pravidla objektu ručně; i3d, obrázek a čísla v i3dMappings dává blender/build_drone_items.py. Chování řeší scripts/SprayDroneItem.lua a SprayDronePadSlots.lua. -->
<vehicle type="FS25_SprayDroneTrailer.sdtDrone">
    <annotation>Skenovací dron: bez nádrže, kamera a multispektrální senzory pod trupem. Nasazuje se na plošinu vleku (R), sken pole pak řídí vlek.</annotation>

    <storeData>
        <name>$l10n_sdt_droneItem_nameK</name>
        <functions>
            <function>$l10n_sdt_droneItem_functionK</function>
        </functions>
        <specs>
            <weight ignore="true"/>
        </specs>
        <image>objects/drone/store_droneK.dds</image>
        <price>6000</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>true</canBeSold>
        <!-- od F2 (PLAN-airasi-kufr.md, D2) je skenovací dron jen kufrová sada; předmět zůstává registrovaný, ať se načtou staré uložené hry -->
        <showInStore>false</showInStore>
        <rotation>0</rotation>
        <shopHeight>1.0</shopHeight>
        <brand>BZUK</brand>
        <category>sprayDroneDrones</category>
        <financeCategory>PURCHASE_FERTILIZER</financeCategory>
    </storeData>

    <base>
        <typeDesc>$l10n_sdt_droneItem_nameK</typeDesc>
        <filename>objects/drone/droneK.i3d</filename>
        <size width="1.15" length="0.80" height="0.80"/>
        <canBeReset>false</canBeReset>
        <supportsPickUp>true</supportsPickUp>
        <components>
            <component centerOfMass="0 0.15 0" solverIterationCount="10" mass="8"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false"/>
        <input allowed="false"/>
    </base>

    <foliageBending>
        <bendingNode minX="-0.45" maxX="0.45" minZ="-0.45" maxZ="0.45" yOffset="0.2"/>
    </foliageBending>
    <wearable wearDuration="480" workMultiplier="5" fieldMultiplier="2"/>
    <washable dirtDuration="90" washDuration="1" workMultiplier="2" fieldMultiplier="2"/>


    <!-- skenovací dron nemá nádrž; fill unit je jen formální, vozidlo typu pallet ho vyžaduje -->
    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="water" capacity="1" showOnHud="false" ignoreFillLimit="true" updateMass="false"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>
    <sprayDroneItem variant="K"/>

    <i3dMappings>
        <i3dMapping id="droneK_main_component1" node="0&gt;"/>
        <i3dMapping id="droneK_vis" node="0&gt;1"/>
        <i3dMapping id="floorCollision01" node="0&gt;0|0"/>
    </i3dMappings>
</vehicle>
