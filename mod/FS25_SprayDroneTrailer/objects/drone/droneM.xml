<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Pravidla objektu ručně; i3d, obrázek a čísla v i3dMappings dává blender/build_drone_items.py. Chování řeší scripts/SprayDroneItem.lua a SprayDronePadSlots.lua. -->
<vehicle type="FS25_SprayDroneTrailer.sdtDrone">
    <annotation>Postřikový dron M, složený: jde nést v rukou a nasadit na plošinu vleku (R); nese svou náplň.</annotation>

    <storeData>
        <name>$l10n_sdt_droneItem_nameM</name>
        <functions>
            <function>$l10n_sdt_droneItem_functionM</function>
        </functions>
        <specs>
            <weight ignore="true"/>
        </specs>
        <image>objects/drone/store_droneM.dds</image>
        <price>12000</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <rotation>0</rotation>
        <shopHeight>1.0</shopHeight>
        <brand>BZUK</brand>
        <category>sprayDroneDrones</category>
        <financeCategory>PURCHASE_FERTILIZER</financeCategory>
    </storeData>

    <base>
        <typeDesc>$l10n_sdt_droneItem_nameM</typeDesc>
        <filename>objects/drone/droneM.i3d</filename>
        <size width="1.20" length="0.95" height="0.80"/>
        <canBeReset>false</canBeReset>
        <supportsPickUp>true</supportsPickUp>
        <components>
            <component centerOfMass="0 0.15 0" solverIterationCount="10" mass="30"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false"/>
        <input allowed="false"/>
    </base>

    <foliageBending>
        <bendingNode minX="-0.45" maxX="0.45" minZ="-0.45" maxZ="0.45" yOffset="0.2"/>
    </foliageBending>
    <wearable wearDuration="480" workMultiplier="5" fieldMultiplier="2"/>
    <washable dirtDuration="90" washDuration="1" workMultiplier="2" fieldMultiplier="2"/>

    <!-- náplň dronu: dron ji z vleku odnese a zase přinese (scripts/SprayDronePadSlots.lua); jeden druh najednou, plnit se nedá jinak než na vleku -->
    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="water liquidFertilizer herbicide lime SDT_FINE_LIME" capacity="40" showOnHud="true" ignoreFillLimit="true" updateMass="false"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <sprayDroneItem variant="M"/>

    <i3dMappings>
        <i3dMapping id="droneM_main_component1" node="0&gt;"/>
        <i3dMapping id="droneM_vis" node="0&gt;1"/>
        <i3dMapping id="floorCollision01" node="0&gt;0|0"/>
    </i3dMappings>
</vehicle>
