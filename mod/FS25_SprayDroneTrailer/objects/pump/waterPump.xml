<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Pravidla objektu ručně; i3d, obrázek a čísla v i3dMappings dává blender/build_pump.py. Chování viz scripts/SprayDronePump.lua. -->
<vehicle type="FS25_SprayDroneTrailer.sdtWaterPump">
    <annotation>Přenosná motorová pumpa na vodu: naftový motor žene odstředivé čerpadlo, sací hadice má ručně přepínaný konec (spojka Storz na IBC / cisternu, nebo sací koš do vody v rybníku, řece, moři) a vodní hadice velkého vleku se připojí na její výtlak.</annotation>

    <storeData>
        <name>$l10n_sdt_pump_name</name>
        <functions>
            <function>$l10n_sdt_pump_function</function>
        </functions>
        <specs>
            <weight ignore="true"/>
        </specs>
        <image>objects/pump/store_waterPump.dds</image>
        <price>1800</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <rotation>0</rotation>
        <shopHeight>1.0</shopHeight>
        <brand>BZUK</brand>
        <category>sprayDroneEquipment</category>
        <financeCategory>PURCHASE_FERTILIZER</financeCategory>
    </storeData>

    <base>
        <typeDesc>$l10n_sdt_pump_name</typeDesc>
        <filename>objects/pump/waterPump.i3d</filename>
        <size width="0.9" length="1.1" height="0.8"/>
        <canBeReset>false</canBeReset>
        <supportsPickUp>true</supportsPickUp>
        <components>
            <component centerOfMass="0 0.30 0" solverIterationCount="10" mass="60"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false"/>
        <input allowed="false"/>
    </base>

    <foliageBending>
        <bendingNode minX="-0.45" maxX="0.45" minZ="-0.6" maxZ="0.6" yOffset="0.2"/>
    </foliageBending>
    <wearable wearDuration="480" workMultiplier="5" fieldMultiplier="2"/>
    <washable dirtDuration="90" washDuration="1" workMultiplier="2" fieldMultiplier="2"/>

    <!-- pořadí fill units: 1 nafta (nalévá se z kanystru jako u mlýnku; exactFillRootNode), 2 voda v tělese čerpadla (jen mezisklad, skript ji
         doplňuje ze hladiny a vodní hadice vleku z ní odebírá jako z IBC) -->
    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="diesel" capacity="15" showOnHud="true" ignoreFillLimit="true" updateMass="false">
                        <exactFillRootNode node="exactFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="water" capacity="200" showOnHud="false" ignoreFillLimit="true" updateMass="false"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <!-- čerpadlo (scripts/SprayDronePump.lua): dieselPerHour = spotřeba za chodu, minDepth = nejmenší hloubka vody pod sacím košem v režimu rybník (m); pourRadius /
         pourRate = nalévání nafty z kanystru nakloněného nad hrdlem nádrže. Uzly: engine = střed motoru (ovládání B), dieselNeck = hrdlo nafty -->
    <sprayDronePump dieselFillUnitIndex="1" waterFillUnitIndex="2" dieselPerHour="3" minDepth="0.15" pourRadius="0.3" pourRate="4">
        <nodes engine="pumpSoundNode" dieselNeck="pumpDieselNeck"/>
        <sounds>
            <engine template="riceFieldPump" linkNode="pumpSoundNode" innerRadius="3" outerRadius="45" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.35" outdoor="0.5"/>
                <pitch indoor="1" outdoor="1"/>
                <lowpassGain indoor="0.4" outdoor="1"/>
            </engine>
            <flow template="riceFieldWater" linkNode="pumpSoundNode" innerRadius="3" outerRadius="30" fadeIn="0.4" fadeOut="0.6" volumeScale="0.8">
                <volume indoor="0.1" outdoor="0.6"/>
                <pitch indoor="1" outdoor="1"/>
                <lowpassGain indoor="0.4" outdoor="1"/>
            </flow>
        </sounds>
    </sprayDronePump>

    <!-- dvě tažné hadice pumpy (scripts/SprayDroneWaterHose.lua, stejný systém jako vodní hadice velkých vleků); hráč vezme hadici u spojky (R) a odnese ji:
         kind inlet = VSTUP, podle režimu pumpy (levé tlačítko myši u spojky, SprayDronePump.pondMode) buď water (konec hadice je spojka Storz hoseEnd, napojí se na výstup
         IBC / cisterny), nebo pond (konec je sací koš strainerEnd, položí se na dno pod hladinu), sink = VÝSTUP (konec na vodní ventil vleku). Pumpa za chodu motoru plní
         těleso ze vstupu a z tělesa plní nádrž vleku; rate = nejvyšší průtok hadice (l/s) -->
    <sprayDroneWaterHose>
        <hoses>
            <hose hoseLength="10" rate="16" hoseEnd="inHoseEnd" strainerEnd="inStrainerEnd" segmentPrefix="inHoseSeg" segmentCount="60">
                <port node="pumpInletPort" kind="inlet"/>
            </hose>
            <hose hoseLength="12" rate="16" hoseEnd="outHoseEnd" segmentPrefix="outHoseSeg" segmentCount="72">
                <port node="pumpOutletPort" kind="sink"/>
            </hose>
        </hoses>
    </sprayDroneWaterHose>

