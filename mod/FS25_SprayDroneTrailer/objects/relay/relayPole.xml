<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Pravidla objektu ručně; i3d, obrázek a čísla v i3dMappings dává blender/build_link_items.py. Objekt poznává SprayDroneLink.lua podle konce názvu souboru. -->
<vehicle type="FS25_SprayDroneTrailer.sdtRelayPole">
    <annotation>Přenosná retranslační tyč na stativu: prodlužuje dosah rádia vleku postřikového dronu, když stojí vzpřímeně na zemi.</annotation>

    <storeData>
        <name>$l10n_sdt_relayPole_name</name>
        <functions>
            <function>$l10n_sdt_relayPole_function</function>
        </functions>
        <specs>
            <weight ignore="true"/>
        </specs>
        <image>objects/relay/store_relayPole.dds</image>
        <price>650</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <rotation>0</rotation>
        <shopHeight>1.6</shopHeight>
        <brand>BZUK</brand>
        <category>sprayDroneEquipment</category>
        <financeCategory>PURCHASE_FERTILIZER</financeCategory>
    </storeData>

    <base>
        <typeDesc>$l10n_sdt_relayPole_name</typeDesc>
        <filename>objects/relay/relayPole.i3d</filename>
        <size width="1.1" length="1.1" height="2.45"/>
        <canBeReset>false</canBeReset>
        <supportsPickUp>true</supportsPickUp>
        <components>
            <component centerOfMass="0 0.25 0" solverIterationCount="10" mass="6"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <!-- ikona na velké mapě: Pallet ji skrývá, SprayDroneRelay:getIsMapHotspotVisible ji vrací -->
        <mapHotspot available="true" type="OTHER"/>
        <!-- vstup jen po nástupu (B zapne / vypne tyč); Pallet ho jinak vypíná -->
        <input allowed="true"/>
    </base>

    <!-- TestRunner je u vozidla (enterable) čeká; stativ zabírá ~1,1 m, tráva se pod ním ohýbá -->
    <foliageBending>
        <bendingNode minX="-0.55" maxX="0.55" minZ="-0.55" maxZ="0.55" yOffset="0.2"/>
    </foliageBending>
    <wearable wearDuration="480" workMultiplier="5" fieldMultiplier="2"/>
    <washable dirtDuration="90" washDuration="1" workMultiplier="2" fieldMultiplier="2"/>

    <!-- baterie tyče: 20 jednotek ELECTRICCHARGE = 5 h provozu (SprayDroneRelay.DISCHARGE_TIME); vanilla nabíjecí stanice
         (0,015/s × zrychlení času) ji nabije za ~22 min herního času, po nástupu do tyče a R u stanice -->
    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit fillTypes="ELECTRICCHARGE" capacity="20" startFillType="ELECTRICCHARGE" startFillLevel="20" showOnHud="true"
                              uiPrecision="1" uiCustomFillTypeName="$l10n_sdt_relay_battery" ignoreFillLimit="true" updateMass="false">
                        <exactFillRootNode node="exactFillRootNode"/>
                        <fillRootNode node="0&gt;"/>
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <!-- nastoupit (E) jde jen do rozložené tyče (SprayDroneRelay:getDistanceToNode / getIsEnterable); kamera obíhá stožár -->
    <enterable isTabbable="false" canBeEnteredFromMenu="false">
        <enterReferenceNode node="relayPole_main_component1" interactionRadius="2.5"/>
        <exitPoint node="relayExitPoint"/>
        <cameras>
            <camera node="relayCamera" rotatable="true" rotateNode="relayCameraRot" limit="true" useWorldXZRotation="true"
                    rotMinX="-1.4" rotMaxX="1.2" transMin="2" transMax="25" translation="0 0 5" rotation="-20 180 0"/>
        </cameras>
    </enterable>

    <!-- síla tyče: dosah (m) tyče i kruhu, který plánovač kreslí; silnější varianta stojí víc -->
    <sprayDroneRelayStrengthConfigurations>
        <sprayDroneRelayStrengthConfiguration name="$l10n_sdt_relay_standard" radius="300" price="0" saveId="STANDARD" isDefault="true"/>
        <sprayDroneRelayStrengthConfiguration name="$l10n_sdt_relay_strong" radius="400" price="450" saveId="STRONG"/>
    </sprayDroneRelayStrengthConfigurations>

    <sprayDroneRelay>
        <leg node="relayLeg1" axis="-1.0000 0.0000 -0.0000" angle="34.80"/>
        <leg node="relayStrut1" axis="-1.0000 0.0000 -0.0000" angle="-53.30"/>
        <leg node="relayLeg2" axis="0.5000 0.0000 0.8660" angle="34.80"/>
        <leg node="relayStrut2" axis="0.5000 0.0000 0.8660" angle="-53.30"/>
        <leg node="relayLeg3" axis="0.5000 0.0000 -0.8660" angle="34.80"/>
        <leg node="relayStrut3" axis="0.5000 0.0000 -0.8660" angle="-53.30"/>
        <slide node="relayCollar" foldedTrans="0 0.25 0"/>
        <mast node="relayMast" foldedTrans="0 -1 0"/>
        <led node="relayLed"/>
        <batteryLed node="relayBatteryLed0"/>
        <batteryLed node="relayBatteryLed1"/>
        <batteryLed node="relayBatteryLed2"/>
        <batteryLed node="relayBatteryLed3"/>
        <batteryLed node="relayBatteryLed4"/>
    </sprayDroneRelay>

    <i3dMappings>
        <i3dMapping id="relayPole_main_component1" node="0&gt;"/>
        <i3dMapping id="relayPole_vis" node="0&gt;13"/>
        <i3dMapping id="floorCollision01" node="0&gt;0|0"/>
        <i3dMapping id="relayLeg1" node="0&gt;9|1"/>
        <i3dMapping id="relayLeg2" node="0&gt;9|2"/>
        <i3dMapping id="relayLeg3" node="0&gt;9|3"/>
        <i3dMapping id="relayStrut1" node="0&gt;14"/>
        <i3dMapping id="relayStrut2" node="0&gt;15"/>
        <i3dMapping id="relayStrut3" node="0&gt;16"/>
        <i3dMapping id="relayCollar" node="0&gt;9"/>
        <i3dMapping id="relayMast" node="0&gt;12"/>
        <i3dMapping id="relayLed" node="0&gt;11"/>
        <i3dMapping id="relayBatteryLed0" node="0&gt;2"/>
        <i3dMapping id="relayBatteryLed1" node="0&gt;3"/>
        <i3dMapping id="relayBatteryLed2" node="0&gt;4"/>
        <i3dMapping id="relayBatteryLed3" node="0&gt;5"/>
        <i3dMapping id="relayBatteryLed4" node="0&gt;6"/>
        <i3dMapping id="relayCameraRot" node="0&gt;8"/>
        <i3dMapping id="relayCamera" node="0&gt;8|0"/>
        <i3dMapping id="relayExitPoint" node="0&gt;10"/>
        <i3dMapping id="exactFillRootNode" node="0&gt;1"/>
    </i3dMappings>
</vehicle>
