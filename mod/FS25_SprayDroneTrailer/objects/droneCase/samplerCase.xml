<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Pravidla objektu ručně; i3d, obrázek a čísla v i3dMappings dává blender/build_drone_case.py (docs/NAVRH-kufr-modely.md, čísla z
     out/case_preview/samplerCase_export.txt). Chování: scripts/SprayDroneCase.lua (kufr), SprayDroneSamples.lua (odběr vzorků PF) a SprayDroneStation
     v profilu portable (docs/DRON.md, „Vzorkovací dron AIRASI (kufr)“). Bez Precision Farming je v obchodě skrytý (SprayDroneStoreCategories). -->
<vehicle type="FS25_SprayDroneTrailer.sdtDroneCase">
    <annotation>Kufr se vzorkovacím dronem (třída AIRASI) a dvěma bateriemi: dron odebírá vzorky půdy Precision Farming v bodech pole (2 na let), nosí je do bedničky v kufru a odtud se odesílají do laboratoře (B u kufru nebo tlačítko v tabletu). Řídí se tabletem jako skenovací kufr.</annotation>

    <storeData>
        <name>$l10n_sdt_sampler_name</name>
        <functions>
            <function>$l10n_sdt_sampler_function</function>
        </functions>
        <specs>
            <weight ignore="true"/>
        </specs>
        <image>objects/droneCase/store_samplerCase.dds</image>
        <price>14600</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <rotation>0</rotation>
        <shopHeight>0.6</shopHeight>
        <brand>BZUK</brand>
        <category>sprayDroneDrones</category>
        <financeCategory>PURCHASE_FERTILIZER</financeCategory>
    </storeData>

    <base>
        <typeDesc>$l10n_sdt_sampler_name</typeDesc>
        <filename>objects/droneCase/samplerCase.i3d</filename>
        <size width="0.75" length="1.15" height="0.55"/>
        <canBeReset>false</canBeReset>
        <supportsPickUp>true</supportsPickUp>
        <components>
            <component centerOfMass="0 0.28 0.02" solverIterationCount="10" mass="32"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="true" type="OTHER"/>
        <input allowed="false"/>
    </base>

    <foliageBending>
        <bendingNode minX="-0.375" maxX="0.375" minZ="-0.575" maxZ="0.575" yOffset="0.18"/>
    </foliageBending>

    <!-- vozidlo typu pallet potřebuje fill unit; kufr nic neveze (viz scanCase.xml) -->
    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="water" capacity="1" showOnHud="false" ignoreFillLimit="true" updateMass="false"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <dynamicMount triggerNode="dynamicMountTrigger" triggerForceAcceleration="4" additionalMountDistance="0.09" jointTransY="0.02" jointLimitToRotY="true"/>

    <!-- víko: čas animace 0 = rozloženo (víko otevřené o 180° leží za kufrem), 1 = složeno a zavřeno (jen tak jde kufr zvednout);
         Foldable začíná složený a rozkládá se k času 0, 6 s. Celé víko vyplňuje bedna na vzorky (zavřená visí nad dronem v pěně,
         vůle ~2 cm). Otevírání (čte se odspodu): víko 6,0-4,92 s, podložka (1,6 m) se vysune ze štěrbiny pod bednou v čele víka -X,
         přenese na zem vedle kufru (-X) a rozevře, dron se přenese z pěny na H, ramena (trailerFoldEnd 0,2). Zavírání obráceně, víko
         až s dronem a podložkou uvnitř. Otevřené víko je bez kolize (floorCollision01 = zavřený kufr). Na podložce dron jen startuje
         a přistává (sonda zasunutá), k odběru sedá na lyžiny v poli. Čísla z blender/build_drone_case.py (*_export.txt). -->
    <animations>
        <animation name="caseLidAnim">
            <part node="droneCarrier" startTime="0.00" endTime="1.20" startTrans="-1.4550 -0.0140 0.1000" endTrans="-1.4550 -0.0120 0.1000"/>
            <part node="droneCarrier" startTime="1.20" endTime="1.68" startTrans="-1.4550 -0.0120 0.1000" endTrans="-1.4550 0.3230 0.1000"/>
            <part node="droneCarrier" startTime="1.68" endTime="2.64" startTrans="-1.4550 0.3230 0.1000" endTrans="0.0000 0.3230 -0.0000"/>
            <part node="droneCarrier" startTime="2.64" endTime="3.12" startTrans="0.0000 0.3230 -0.0000" endTrans="0.0000 0.0000 -0.0000"/>
            <part node="casePad" startTime="3.12" endTime="3.60" startScale="1.0000 1.0000 1.0000" endScale="0.3333 3.0000 0.3333"/>
            <part node="casePad" startTime="3.60" endTime="3.90" startTrans="-1.4550 0.2780 -0.3890" endTrans="-1.4550 0.1580 -0.3890" startRot="180.0 0 0" endRot="180.0 0 0"/>
            <part node="casePad" startTime="3.90" endTime="4.38" startTrans="-1.4550 0.1580 -0.3890" endTrans="-0.8817 0.1580 0.3890"/>
            <part node="casePad" startTime="4.38" endTime="4.56" startTrans="-0.8817 0.1580 0.3890" endTrans="-0.8817 0.2512 0.3890"/>
            <part node="casePad" startTime="4.56" endTime="4.92" startTrans="-0.8817 0.2512 0.3890" endTrans="-0.2703 0.2512 0.3890"/>
            <part node="caseLid" startTime="4.92" endTime="6.00" startRot="-180.0 0 0" endRot="0.0 0 0"/>
        </animation>
    </animations>

    <foldable>
        <foldingConfigurations>
            <foldingConfiguration>
                <foldingParts startMoveDirection="1" requiresPower="false" objectText="$l10n_sdt_sampler_name">
                    <foldingPart animationName="caseLidAnim" speedScale="1"/>
                </foldingParts>
            </foldingConfiguration>
        </foldingConfigurations>
    </foldable>

    <!-- profil portable jako skenovací kufr. Dron P (AIRASI, odhad: 4,5 kg, baterie 0,2 kWh na 25 min): nad body letí ve výšce sprayHeight,
         k odběru sedne na pevné lyžiny (sampler#height = kořen dronu nad terénem); sonda droneProbe pod trupem vyjede o probeTravel
         a hrot sahá ~0,2 m pod povrch. Nese 2 krabičky za sebou pod trupem (droneSampleBox1/2), bedna ve víku má 6 x 4 = 24 přihrádek (sampleSlot1–24).
         Počasí jako postřik (sprayMaxWind, déšť), tma nevadí. maxRange = rádio kufru (400 m); dál pomůže relé tyč
         (všesměrová i směrová, objects/relay). -->
