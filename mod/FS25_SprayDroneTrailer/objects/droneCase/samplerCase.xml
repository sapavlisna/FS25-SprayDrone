            <tilt node="Drone_P_Tilt"/>
            <foldPart node="Drone_P_ArmPivot_1" foldedRot="0.000 77.755 0.000" unfoldedRot="0.000 -43.854 0.000" startTime="0" endTime="0.6"/>
