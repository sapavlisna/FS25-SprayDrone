<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="millDust" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Files>
    <File fileId="1" filename="$data/effects/smoke/smoke6x6_diffuse.png"/>
    <File fileId="2" filename="$data/effects/smoke/smoke6x6_normal.png"/>
    <File fileId="4" filename="$data/shaders/psSubUVShader.xml"/>
    <File fileId="3" filename="$data/shared/default_specular.png"/>
  </Files>

  <Materials>
    <Material name="lambert1" materialId="5" diffuseColor="0.494118 0.494118 0.494118 1">
    </Material>
    <Material name="dust_mat" materialId="6" alphaBlending="true" customShaderId="4" customShaderVariation="subUV" shadingRate="4x4">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <CustomParameter name="playScale" value="20 40 1 0"/>
      <CustomParameter name="colorAlpha" value="0.94 0.94 0.92 1"/>
    </Material>
  </Materials>

  <Shapes externalShapesFile="millDust.i3d.shapes">
  </Shapes>

  <Dynamics>
    <ParticleSystem name="millDustIn" dynamicId="1" type="sprite" rate="0.01" lifespan="1800" maxCount="120" speed="0.000350" speedRandom="0.000087" tangentSpeed="1.000" normalSpeed="1" damping="0.0" spriteScaleX="0.12" spriteScaleY="0.12" spriteScaleXGain="0.000239" spriteScaleYGain="0.000239" blendFactor="0.22" blendInFactor="0.25" blendOutFactor="0.7" depthSort="true" randomInitRotation="true" deltaRotateMin="-0.0003" deltaRotateMax="0.0003" textureAtlasSizeX="6" textureAtlasSizeY="6">
      <Gravity force="0 0 0"/>
    </ParticleSystem>
    <ParticleSystem name="millDustOut" dynamicId="2" type="sprite" rate="0.014" lifespan="2200" maxCount="200" speed="0.000500" speedRandom="0.000125" tangentSpeed="1.200" normalSpeed="1" damping="0.0" spriteScaleX="0.2" spriteScaleY="0.2" spriteScaleXGain="0.000318" spriteScaleYGain="0.000318" blendFactor="0.2" blendInFactor="0.25" blendOutFactor="0.7" depthSort="true" randomInitRotation="true" deltaRotateMin="-0.0003" deltaRotateMax="0.0003" textureAtlasSizeX="6" textureAtlasSizeY="6">
      <Gravity force="0 0 0"/>
    </ParticleSystem>
  </Dynamics>

  <Scene>
    <TransformGroup name="millDust" nodeId="1">
    <Dynamic name="millDustIn" dynamicId="1" emitterShapeNodeId="11" clipDistance="80" nodeId="10" castsShadows="false" receiveShadows="false" distanceBlending="false" materialIds="6">
      <Shape name="mistEmitShape" shapeId="1" nodeId="11" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
    </Dynamic>
    <Dynamic name="millDustOut" dynamicId="2" emitterShapeNodeId="13" clipDistance="80" nodeId="12" castsShadows="false" receiveShadows="false" distanceBlending="false" materialIds="6">
      <Shape name="mistEmitShape" shapeId="1" nodeId="13" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
    </Dynamic>
    </TransformGroup>
  </Scene>
</i3D>
