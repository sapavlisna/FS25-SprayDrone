    <!-- stanoviště u vozíku: nastoupit jde vždy (jako do velkého vleku), motor zapíná B (IMPLEMENT_EXTRA), ventil výstupu Y (IMPLEMENT_EXTRA3), výsypnou
         rouru O (TOGGLE_PIPE); pěšky B nebo klik na tlačítko rozvaděče, klik na páku ventilu, klik na kloub roury -->
    <enterable isTabbable="false">
        <enterReferenceNode node="sdtLimeMill_main_component1" interactionRadius="5"/>
        <exitPoint node="exitPoint"/>
        <cameras>
            <camera node="outdoorCamera" rotatable="true" rotateNode="outdoorCameraTarget" limit="true" useWorldXZRotation="true"
                    rotMinX="-1.4" rotMaxX="1.2" transMin="2" transMax="30" translation="0 0 8" rotation="-20 180 0"/>
        </cameras>
    </enterable>

    <animations>
        <!-- opěrné kolečko: čas 0 = zapřaženo (zvednuté), čas 1 = odpojeno (na zemi, model v i3d) -->
        <animation name="moveSupport">
            <part node="jockeyWheel" startTime="0" endTime="1" startTrans="0.115 0.81515 1.56" endTrans="0.115 0.58515 1.56"/>
            <sound template="slideOpen" startTime="0.02" direction="1" volumeScale="1.5" pitchScale="1.4" linkNode="jockeyWheel"/>
            <sound template="slideOpen" startTime="0.98" direction="-1" volumeScale="1.5" pitchScale="1.4" linkNode="jockeyWheel"/>
            <sound template="clackVar1" startTime="0.95" direction="1" volumeScale="1.1" pitchScale="1.1" linkNode="jockeyWheel"/>
            <sound template="clackVar1" startTime="0.05" direction="-1" volumeScale="1.1" pitchScale="1.1" linkNode="jockeyWheel"/>
        </animation>
        <!-- výsypná roura (scripts/SprayDroneMill.lua, ne vanilla Pipe): otočení kolem svislé osy kloubu, čas 0 = přeprava (rameno dopředu podél násypky),
             0,5 = vedle vozíku (vpravo), 1 = za vozíkem; skript zastavuje na stavech přes setAnimationStopTime -->
        <animation name="spoutSwing">
            <part node="millSpoutPivot" startTime="0" endTime="6" startRot="0 0 0" endRot="0 -180 0"/>
            <sound template="slideOpen" startTime="0.02" direction="1" volumeScale="1.2" pitchScale="0.8" linkNode="millSpoutJoint"/>
            <sound template="slideOpen" startTime="5.98" direction="-1" volumeScale="1.2" pitchScale="0.8" linkNode="millSpoutJoint"/>
            <sound template="clackVar1" startTime="5.95" direction="1" volumeScale="1.1" linkNode="millSpoutJoint"/>
            <sound template="clackVar1" startTime="0.05" direction="-1" volumeScale="1.1" linkNode="millSpoutJoint"/>
        </animation>
        <!-- páka klapkového ventilu (rozdělovač pod nádobkou jemného vápna): čas 0 = vodorovně ven = hadice, čas 1 = svisle nahoru = roura -->
        <animation name="valveLever">
            <part node="millValveLever" startTime="0" endTime="0.6" startRot="0 0 0" endRot="0 0 -90"/>
            <sound template="clackVar1" startTime="0.55" direction="1" volumeScale="1.0" pitchScale="1.3" linkNode="millValveLever"/>
            <sound template="clackVar1" startTime="0.05" direction="-1" volumeScale="1.0" pitchScale="1.3" linkNode="millValveLever"/>
        </animation>
    </animations>

    <fillUnit>
        <fillUnitConfigurations>
            <!-- pořadí fill units: 1 hrubé vápno (vanilla lime, plní se vyklopením návěsu nebo big bagu do nádoby), 2 nafta pro motor,
                 3 jemně mleté vápno (mezisklad pod cyklónem, odkud jde hadice do nádobky velkého vleku); scripts/SprayDroneMill.lua -->
            <fillUnitConfiguration name="$l10n_sdt_limeMill_cfg" price="0" saveId="MILL" isDefault="true">
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="lime" capacity="2400">
                        <exactFillRootNode node="exactFillRootNode"/>
                        <!-- hladina hrubého vápna (rovina 1,72 x 1,56 m v ose násypky): výsyp y 1,00, šikmé stěny do 2,05, svislý lem do 2,40; klíče podle objemu nádoby do 2,25 (plná = kus pod okrajem) -->
                        <fillPlane>
                            <node node="coarseFillPlane">
                                <key time="0" y="1.00" scale="0.17 1 0.19"/>
                                <key time="0.014" y="1.15" scale="0.29 1 0.31"/>
                                <key time="0.045" y="1.30" scale="0.41 1 0.42"/>
                                <key time="0.099" y="1.45" scale="0.52 1 0.54"/>
                                <key time="0.183" y="1.60" scale="0.64 1 0.65"/>
                                <key time="0.303" y="1.75" scale="0.76 1 0.77"/>
                                <key time="0.467" y="1.90" scale="0.88 1 0.88"/>
                                <key time="0.68" y="2.05" scale="1 1 1"/>
                                <key time="1" y="2.25" scale="1 1 1"/>
                            </node>
                        </fillPlane>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="diesel" capacity="40">
                        <exactFillRootNode node="dieselFillRootNode"/>
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="SDT_FINE_LIME" capacity="150"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <!-- mlýn (scripts/SprayDroneMill.lua): millRate = mletí hrubého vápna na jemné (l/s), dieselPerHour = spotřeba motoru za chodu,
         hoseRate = nejvyšší průtok výstupem jemného vápna (l/s; čerpá pumpa velkého vleku sací hadicí); pourRadius / pourRate = nalévání
         nafty z kanystru nakloněného nad hrdlem nádrže. Uzly: engine = střed motoru (zvuk), button = tlačítko na rozvaděči (klik myší
         nebo B v dosahu zapne a vypne mlýnek), ring = svítící prstenec kolem tlačítka (materiál staticLight_vertex, svítí za chodu motoru
         svitem ringIntensity), dieselNeck = hrdlo nafty, outlet = výstup jemného vápna (spojka Storz), portCap = slepá spojka výstupu, valveLever =
         páka rozdělovače (klik pěšky přepne hadice / roura), spoutJoint = kloub výsypné roury (klik pěšky: přeprava -> vedle -> za -> přeprava) -->
    <sprayDroneMill coarseFillUnitIndex="1" dieselFillUnitIndex="2" fineFillUnitIndex="3" fineFillType="SDT_FINE_LIME"
                    millRate="6" dieselPerHour="6" hoseRate="8" pourRadius="0.3" pourRate="4" ringIntensity="4">
        <nodes engine="millSoundNode" button="millStartButton" ring="millStartRing" dieselNeck="millDieselNeck" outlet="millOutletPort"
               portCap="millPortCap" valveLever="millValveLever" spoutJoint="millSpoutJoint"/>
        <!-- plnění big bagu výsypnou rourou (ventil na rouru, roura vyklopená vedle nebo za vozík, motor běží, vozík stojí): head = střed čela límce plnicí
             hlavy (osa 1,02 m nad zemí, ústí míří vodorovně od kloubu), pivot = svislá osa kloubu, neck = plnicí rukáv z hlavy do boku vaku (vidět jen za plnění).
             Hlava stojí z boku vaku na straně k vozíku, střed vaku je o neckOffset dál od kloubu (8 cm mezera + polovina hloubky vaku 0,42 m): nic z roury
             nesahá nad půdorys vaku, plný vak jde zvednout za poutka a odvézt od vozíku. Vak se hledá do halfWidth vodorovně od očekávaného středu
             a od 0,8 do depth pod hlavou; když nestojí žádný, mlýnek ho postaví (kořen na terén, hloubkou podél ramene) -->
        <bagOutput head="millFillHead" pivot="millSpoutPivot" neck="millBagNeck" neckOffset="0.50" halfWidth="0.6" depth="2.5"/>
        <!-- prach za chodu (jen klient; částicový systém effects/millDust.i3d, build blender/build_mill_dust.py): milling = za mletí lehký prach u výsypky
             šneku do mlýna (uzel millDustIn), blowing = když se do big bagu opravdu sype, prach u ústí plnicí hlavy (uzel millFillHead); node = Dynamic v i3d efektu -->
        <dust>
            <milling>
                <effectNode effectClass="ParticleEffect" filename="effects/millDust.i3d" node="0|0" linkNode="millDustIn"/>
            </milling>
            <blowing>
                <effectNode effectClass="ParticleEffect" filename="effects/millDust.i3d" node="0|1" linkNode="millFillHead"/>
            </blowing>
        </dust>
        <sounds>
            <engine template="generator05" linkNode="millSoundNode" innerRadius="3" outerRadius="45" fadeIn="0.3" fadeOut="0.3">
                <volume indoor="0.35" outdoor="0.5"/>
                <pitch indoor="1" outdoor="1"/>
                <lowpassGain indoor="0.4" outdoor="1"/>
            </engine>
            <grind template="grainMillWork" linkNode="millSoundNode" innerRadius="3" outerRadius="40" fadeIn="0.4" fadeOut="0.6" volumeScale="0.9">
                <volume indoor="0.3" outdoor="1.0"/>
                <pitch indoor="0.8" outdoor="0.8"/>
                <lowpassGain indoor="0.4" outdoor="1"/>
            </grind>
            <pump template="pressureWasherRun01" linkNode="millOutletPort" innerRadius="3" outerRadius="30" fadeIn="0.2" fadeOut="0.3" volumeScale="0.7"/>
        </sounds>
    </sprayDroneMill>

