<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI onOpen="onOpen" onClose="onClose">
    <Bitmap profile="baseReference" imageColor="0 0 0 1"/>
    <InGameMap id="ingameMap" profile="ingameMapOverview" cursorId="mapCursor" onClickMap="onClickMap"
        onDrawPostIngameMap="onDrawPostIngameMap" onDrawPostIngameMapHotspots="onDrawPostIngameMapHotspots"/>
    <Bitmap profile="ingameMapCursor" id="mapCursor" visible="false"/>
    <Bitmap profile="sdtLeftColumn" id="leftColumn"/>

    <GuiElement profile="fs25_menuContainer" id="menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="headerIcon"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="headerTitle"/>
        </GuiElement>
        <!-- který vlek / kufr plánovač ovládá: šipky (a PageUp / PageDown) přepnou, poloha pod záhlavím v onGuiSetupFinished -->
        <MultiTextOption profile="fs25_aiCreateJobMultiTextOption" id="targetSelector" onClick="onClickTargetSelector"/>
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="pagesContainer">
            <GuiElement absoluteSizeOffset="0 -21px">
                <ThreePartBitmap profile="fs25_subCategoryContainerBg" id="leftBox">
                    <Bitmap profile="fs25_subCategoryContainerArrow"/>
                </ThreePartBitmap>
                <Bitmap profile="fs25_subCategoryContainer" id="pageBox">
                    <MultiTextOption profile="fs25_subCategorySelector" id="pageSelector" onClick="onClickPageSelector"/>
                    <BoxLayout profile="fs25_subCategorySelectorBox" id="pageDotBox">
                        <RoundCorner profile="fs25_subCategorySelectorDot"/>
                        <RoundCorner profile="fs25_subCategorySelectorDot"/>
                        <RoundCorner profile="fs25_subCategorySelectorDot"/>
                        <RoundCorner profile="fs25_subCategorySelectorDot"/>
                    </BoxLayout>
                    <GuiElement profile="fs25_subCategoryListContainer" id="pageFields">
                        <SmoothList profile="fs25_subCategoryList" id="fieldList" listSectionHeader="section"
                            startClipperElementName="startClipper" endClipperElementName="endClipper"
                            onClick="onClickFieldList" selectedWithoutFocus="true" emptyIndicatorId="fieldListEmpty">
                            <ListItem profile="fs25_subCategoryListItem">
                                <Bitmap profile="sdtFieldListIcon" name="icon"/>
                                <Text profile="fs25_workerListItemHelper" name="helper"/>
                                <Text profile="fs25_subCategoryListItemName" name="title"/>
                                <Text profile="fs25_workerListItemDescription" name="text"/>
                            </ListItem>
                            <ListItem profile="fs25_subCategoryListSectionHeader" name="section">
                                <Text profile="fs25_subCategoryListSectionHeaderTitle" name="title"/>
                            </ListItem>
                        </SmoothList>
                        <Bitmap profile="fs25_subCategoryStartClipper" name="startClipper"/>
                        <Bitmap profile="fs25_subCategoryStopClipper" name="endClipper"/>
                        <ThreePartBitmap profile="fs25_subCategoryListSliderBox">
                            <Slider profile="fs25_listSlider" dataElementId="fieldList"/>
                        </ThreePartBitmap>
                        <Text profile="fs25_aiContainerEmptyText" id="fieldListEmpty" text="$l10n_sdt_ui_noFieldsNear"/>
                    </GuiElement>

                    <GuiElement profile="fs25_subCategoryListContainer" id="pageMission">
                        <BoxLayout profile="fs25_aiCreateJobLayout" id="missionLayout"/>
                        <Text profile="fs25_aiCreateJobParameterTitle" id="settingTitlePrefab" size="100% 30px"/>
                        <MultiTextOption profile="fs25_aiCreateJobMultiTextOption" id="settingPrefab" onClick="onClickSettingOption"
                            onFocus="onFocusSettingOption"/>
                    </GuiElement>

                    <GuiElement profile="fs25_subCategoryListContainer" id="pageFlight">
                        <BoxLayout profile="fs25_aiCreateJobLayout" id="flightLayout"/>
                    </GuiElement>

                    <GuiElement profile="fs25_subCategoryListContainer" id="pageMap">
                        <SmoothList profile="fs25_mapList" id="legendList" listSectionHeader="section"
                            startClipperElementName="startClipper" endClipperElementName="endClipper" onClick="onClickLegendList"
                            selectedWithoutFocus="true">
                            <ListItem profile="fs25_mapListItem">
                                <Bitmap profile="fs25_mapListItemIconBg" name="iconBg"/>
                                <Text profile="fs25_mapListItemName" name="name"/>
                            </ListItem>
                            <ListItem profile="fs25_subCategoryListSectionHeader" name="section">
                                <Text profile="fs25_subCategoryListSectionHeaderTitle" name="title"/>
                            </ListItem>
                        </SmoothList>
                        <Bitmap profile="fs25_subCategoryStartClipper" name="startClipper"/>
                        <Bitmap profile="fs25_subCategoryStopClipper" name="endClipper"/>
                        <ThreePartBitmap profile="fs25_subCategoryListSliderBox">
                            <Slider profile="fs25_listSlider" dataElementId="legendList"/>
                        </ThreePartBitmap>
                    </GuiElement>
                </Bitmap>
            </GuiElement>
        </GuiElement>

    </GuiElement>

    <BoxLayout profile="fs25_buttonBox" id="buttonBox">
        <Button profile="buttonBack" id="closeButton" text="Close" onClick="onClickBack"/>
        <Button profile="buttonOK" id="startButton" text="Start" onClick="onClickStart">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
        <Button profile="buttonActivate" id="returnButton" text="Return" onClick="onClickReturn">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
        <Button profile="buttonMenuSwitch" id="drawButton" text="Draw" onClick="onClickDraw">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
        <Button profile="buttonActivate" inputAction="MENU_EXTRA_2" id="undoButton" text="Undo" onClick="onClickUndo">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
        <!-- Návrat má Space (MENU_ACTIVATE z profilu), Restart pole / Odeslat vzorky End, ať nesdílí klávesu -->
        <Button profile="buttonActivate" inputAction="MENU_LIST_PAGE_END" id="resetFieldButton" text="Restart field" onClick="onClickResetField">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
        <Button profile="buttonDelete" id="deleteAreaButton" text="Delete" onClick="onClickDeleteArea">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
        <Button profile="buttonActivate" inputAction="MENU_PAGE_PREV" id="settingDownButton" text="Lower" onClick="onClickSettingDown">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
        <Button profile="buttonActivate" inputAction="MENU_PAGE_NEXT" id="settingUpButton" text="Raise" onClick="onClickSettingUp">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
    </BoxLayout>

    <GuiProfiles>
        <Profile name="sdtFieldListIcon" extends="fs25_workerListItemIcon"/>
        <Profile name="sdtLeftColumn" extends="baseReference" with="anchorTopLeft">
            <imageColor value="0.004 0.004 0.004 0.92"/>
            <size value="400px 100%"/>
        </Profile>
    </GuiProfiles>
</GUI>
